				"say \\\"hi\\\"",
				"first\nsecond"
			]
		},
		{
			"name": "strings.rs as rs",
			"file": "strings.rs",
			"fileType": "rs",
			"options": {},
			"expected": [
				"the docs",
				"a raw \"quoted\" string",
				"holds a \"# sequence",
				"C:\\Users\\test",
				"payload",
				"say \\\"hi\\\"",
				"first\nsecond"
			]
		},
		{
			"name": "strings.go as go",
			"file": "strings.go",
			"fileType": "go",
			"options": {},
